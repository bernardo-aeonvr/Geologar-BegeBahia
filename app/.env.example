# Copie para .env.local e ajuste. Nunca versione .env com valores reais.

# Origem das mídias (panoramas, vídeos, narrações e manifest.json).
# Padrão: "./media/" (relativo ao app — GitHub Pages e pacote offline).
# Servidor próprio/CDN: VITE_MEDIA_BASE_URL=https://media.exemplo.com/geologar/
# O servidor precisa aceitar HTTP Range e enviar CORS (Access-Control-Allow-Origin) se for outra origem.
VITE_MEDIA_BASE_URL=./media/

# Perfil de mídia padrão quando a detecção automática não decidir: mobile | web | high
VITE_MEDIA_PROFILE=

# Base do app no build (padrão "./"). Só use se um target exigir base absoluta.
# VITE_BASE=/Geologar-BegeBahia/
